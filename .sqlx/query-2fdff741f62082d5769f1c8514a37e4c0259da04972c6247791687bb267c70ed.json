{
  "db_name": "PostgreSQL",
  "query": "SELECT id, sender_device_id, epoch, ciphertext, is_commit,\n                (EXTRACT(EPOCH FROM created_at) * 1000)::BIGINT AS \"ts!\"\n         FROM envelopes\n         WHERE conversation_id = $1 AND id > $2\n         ORDER BY id\n         LIMIT $3",
